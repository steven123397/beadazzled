{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "beadazzled",
  "version": "0.1.1",
  "identifier": "com.steven123397.beadazzled",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "beadazzled",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'"],
        "script-src": ["'self'"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "connect-src": ["'self'", "ipc:", "http://ipc.localhost"],
        "img-src": ["'self'", "data:"],
        "font-src": ["'self'"],
        "object-src": ["'none'"],
        "frame-src": ["'none'"],
        "frame-ancestors": ["'none'"],
        "base-uri": ["'none'"],
        "form-action": ["'none'"],
        "media-src": ["'none'"]
      },
      "devCsp": {
        "default-src": ["'self'", "http://localhost:1420"],
        "script-src": ["'self'", "'unsafe-inline'", "http://localhost:1420"],
        "style-src": ["'self'", "'unsafe-inline'", "http://localhost:1420"],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "http://localhost:1420",
          "ws://localhost:1420",
          "ws://localhost:1421"
        ],
        "img-src": ["'self'", "data:", "http://localhost:1420"],
        "font-src": ["'self'", "http://localhost:1420"],
        "object-src": ["'none'"],
        "frame-src": ["'none'"],
        "frame-ancestors": ["'none'"],
        "base-uri": ["'none'"],
        "form-action": ["'none'"],
        "media-src": ["'none'"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5RkMyRTUzQkMwRTE3MDgKUldRSUZ3NjhVeTc4NlFUVW9wb2hndk9rajBtZzlXNFFHbVJ4MjVyS1liakRKb1hXT1liR3hHM0MK",
      "endpoints": [
        "https://github.com/steven123397/beadazzled/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../NOTICE": "NOTICE",
      "../LICENSE": "LICENSE"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
