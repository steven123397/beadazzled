{
  "name": "beadazzled",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Windows desktop frontend for beads",
  "license": "MIT",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:rust:coverage": "node scripts/check-bridge-coverage.mjs",
    "gen:bindings": "cargo test --manifest-path src-tauri/Cargo.toml export_bindings",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "check:fast": "npm run typecheck && npm run lint && npm run check:secrets",
    "check:task": "npm run check:boundaries && npm run test:unit -- --coverage && npm run test:rust:coverage",
    "check:full": "npm run check:fast && npm run check:task && npm run test:rust && npm run check:deps && npm run build && npm run build:app && npm run check:size && npm run e2e",
    "build": "tsc -b && vite build",
    "build:app": "tauri build",
    "check:size": "node scripts/check-size.mjs",
    "e2e": "playwright test",
    "measure:startup": "node scripts/measure-startup.mjs",
    "measure:memory": "node scripts/measure-memory.mjs",
    "measure:navigation": "node scripts/measure-navigation.mjs",
    "measure:scroll": "node scripts/measure-scroll.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
